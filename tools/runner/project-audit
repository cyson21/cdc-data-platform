def render_completion_report(proof):
    lakehouse = proof["lakehouseProofAudit"]
    phase2_sla = proof["phase2RuntimeSlaProofAudit"]
    phase2_replay = proof["phase2RuntimeLakehouseReplayAudit"]
    runtime = phase2_sla.get("runtimeObservation") or {}
    record = phase2_sla.get("controlPlanePersistence") or {}
    replay = phase2_replay.get("replay") or {}
    source_lsn = runtime.get("sourceLsn") or record.get("sourceLsn") or replay.get("sourceLsn") or []
    event_source_offset = (
        runtime.get("eventSourceOffset")
        or record.get("eventSourceOffset")
        or replay.get("eventSourceOffset")
        or []
    )
    event_ids = runtime.get("eventIds") or record.get("eventIds") or replay.get("eventIds") or []

    lines = [
        "# Project 05 Local-First Completion Report",
        "",
        "This report is generated from the current `project-audit` result and the proof artifacts under `lakehouse/out/proofs/`.",
        "",
        "## Status",
        "",
        f"- completionReady: {str(proof['completionReady']).lower()}",
        f"- completionScope: {proof['completionScope']}",
        f"- optionalCloudProofReady: {str(proof['optionalCloudProofReady']).lower()}",
        f"- repositoryRoot: {proof['repository']['gitRoot']}",
        "",
        "## Evidence Boundary",
        "",
        "- Local-first MVP completion is based on repository boundary checks, TODO state, lakehouse proof audit, Phase 2 runtime SLA paired proof, and runtime-to-lakehouse replay proof.",
        "- Docker/local proof is reproducible local evidence and is not production-scale performance proof.",
        "- AWS Athena/dbt-athena remains opt-in and is not claimed until an explicit successful cloud proof artifact exists.",
        "",
        "## Local-First Proof Highlights",
        "",
        f"- lakehouseProofAudit: completionReady={str(lakehouse['completionReady']).lower()}, localMvpReady={str(lakehouse['localMvpReady']).lower()}",
        f"- phase2RuntimeSlaProofAudit: status={phase2_sla['status']}, completionReady={str(phase2_sla['completionReady']).lower()}",
        f"- phase2RuntimeLakehouseReplayAudit: status={phase2_replay['status']}, completionReady={str(phase2_replay['completionReady']).lower()}",
        f"- source LSN: {json.dumps(source_lsn, sort_keys=True)}",
        f"- event source offset: {json.dumps(event_source_offset, sort_keys=True)}",
        f"- event id: {json.dumps(event_ids, sort_keys=True)}",
        "",
        "## Lakehouse Requirements",
        "",
    ]
    for requirement in lakehouse.get("requirements", []):
        lines.append(
            f"- {requirement['id']}: {requirement['status']} "
            f"({requirement['requirementScope']}, {requirement['evidenceLevel']})"
        )

    lines.extend([
        "",
        "## Optional Cloud Proof",
        "",
    ])
    optional_actions = proof.get("optionalNextActions", [])
    if not optional_actions:
        lines.append("- None.")
    for action in optional_actions:
        action_id = action.get("id") or action.get("section") or action["source"]
        lines.append(f"- {action_id}: {action['text']}")

    lines.extend([
        "",
        "## Recheck",
        "",
        "```bash",
        "./tools/runner/project-audit --write-next-proof-manifest --write-completion-report --run-local-verification",
        "```",
        "",
    ])
    return "\n".join(lines)


def write_audit_artifacts(proof, output_dir):
    output_dir.mkdir(parents=True, exist_ok=True)
    audit_path = output_dir / "project-completion-audit.json"
    manifest_path = output_dir / "next-proof-commands.md"
    audit_path.write_text(json.dumps(proof, indent=2, sort_keys=True), encoding="utf-8")
    manifest_path.write_text(render_next_proof_manifest(proof), encoding="utf-8")
    return {
        "auditJson": str(audit_path),
        "nextProofManifest": str(manifest_path),
    }


def write_completion_report(proof, output_dir):
    output_dir.mkdir(parents=True, exist_ok=True)
    report_path = output_dir / "completion-report.md"
    report_path.write_text(render_completion_report(proof), encoding="utf-8")
    return {
        "completionReport": str(report_path),
    }


def local_verification_commands(output_dir):
    manifest_output_dir = output_dir / "manifest"
    return [
        {
            "id": "runner-py-compile",
            "command": [
                sys.executable,
                "-m",
                "py_compile",
                "tools/runner/project-audit",
                "tools/runner/lakehouse-smoke",
                "tools/runner/cdc-smoke",
                "tools/runner/control-plane-smoke",
            ],
        },
        {
            "id": "lakehouse-proof-audit-focused-test",
            "command": [
                sys.executable,
                "tools/tests/test_lakehouse_smoke.py",
                "-k",
                "lakehouse_proof_audit",
            ],
        },
        {
            "id": "compose-config",
            "command": [
                "docker",
                "compose",
                "-f",
                "infra/local/docker-compose.yml",
                "config",
                "-q",
            ],
        },
        {
            "id": "project-audit-manifest",
            "command": [
                str(ROOT / "tools" / "runner" / "project-audit"),
                "--write-next-proof-manifest",
                "--write-completion-report",
                "--output-dir",
                str(manifest_output_dir),
            ],
        },
    ]


def run_local_verification(output_dir):
    commands = []
    for entry in local_verification_commands(output_dir):
        completed = run_command(entry["command"], check=False)
        commands.append({
            "id": entry["id"],
            "command": entry["command"],
            "exitCode": completed.returncode,
            "stdout": truncate_text(completed.stdout),
            "stderr": truncate_text(completed.stderr),
        })

    verification = {
        "scenario": "project-local-verification",
        "evidenceLabel": "local-verification",
        "includesLiveProof": False,
        "commands": commands,
        "passed": all(item["exitCode"] == 0 for item in commands),
        "notes": (
            "Local verification only. This does not run live MinIO/S3-compatible, "
            "engine-backed Iceberg, Athena, or dbt-athena proof scenarios."
        ),
    }
    output_dir.mkdir(parents=True, exist_ok=True)
    path = output_dir / "local-verification.json"
    path.write_text(json.dumps(verification, indent=2, sort_keys=True), encoding="utf-8")
    return path, verification


def project_completion_audit(
    todo_file,
    output_dir,
    proof_dir,
    write_next_proof_manifest=False,
    write_completion_report_flag=False,
    run_local_verification_flag=False,
):
    repository = git_repository_status()
    todo = parse_todo(todo_file)
    lakehouse = lakehouse_proof_audit()
    phase2_runtime_sla = phase2_runtime_sla_proof_audit(proof_dir)
    phase2_runtime_replay = phase2_runtime_lakehouse_replay_audit(proof_dir)
    completion_ready = (
        repository["insideExpectedRoot"]
        and todo["mvpUncheckedCount"] == 0
        and lakehouse.get("completionReady") is True
        and phase2_runtime_sla.get("completionReady") is True
        and phase2_runtime_replay.get("completionReady") is True
    )
    proof = {
        "scenario": "project-completion-audit",
        "evidenceLabel": "project-completion-audit",
        "completionReady": completion_ready,
        "completionScope": "local-first-mvp",
        "optionalCloudProofReady": lakehouse.get("optionalCloudProofReady") is True,
        "repository": repository,
        "todo": todo,
        "lakehouseProofAudit": lakehouse,
        "phase2RuntimeSlaProofAudit": phase2_runtime_sla,
        "phase2RuntimeLakehouseReplayAudit": phase2_runtime_replay,
        "nextActions": build_next_actions(todo, lakehouse, phase2_runtime_sla, phase2_runtime_replay),
        "optionalNextActions": build_optional_next_actions(todo, lakehouse),
        "notes": (
            "CompletionReady covers the local-first MVP gate from the ADR and roadmap plus paired Phase 2 runtime SLA proof "
            "and local runtime-to-lakehouse replay proof. "
            "Optional AWS Athena/dbt-athena proof remains visible separately and is not claimed unless an opt-in proof artifact exists."
        ),
    }
    if write_next_proof_manifest:
        proof["artifacts"] = write_audit_artifacts(proof, output_dir)
    if write_completion_report_flag:
        artifacts = proof.setdefault("artifacts", {})
        artifacts.update(write_completion_report(proof, output_dir))
    if run_local_verification_flag:
        verification_path, verification = run_local_verification(output_dir)
        artifacts = proof.setdefault("artifacts", {})
        artifacts["localVerificationJson"] = str(verification_path)
        proof["localVerification"] = verification
        if not verification["passed"]:
            print(json.dumps(proof, indent=2, sort_keys=True))
            raise RuntimeError("local verification failed")
    print(json.dumps(proof, indent=2, sort_keys=True))


def main():
    parser = argparse.ArgumentParser(description="Run project completion audit for Project 05.")
    parser.add_argument(
        "--todo-file",
        default=str(ROOT / "TODO.md"),
        help="path to the TODO checklist used as the project completion source",
    )
    parser.add_argument(
        "--output-dir",
        default=str(DEFAULT_OUTPUT_DIR),
        help="directory for generated project audit artifacts",
    )
    parser.add_argument(
        "--proof-dir",
        default=str(DEFAULT_PROOF_DIR),
        help="directory containing machine-readable proof artifacts",
    )
    parser.add_argument(
        "--write-next-proof-manifest",
        action="store_true",
        help="write the audit JSON and next proof command manifest",
    )
    parser.add_argument(
        "--write-completion-report",
        action="store_true",
        help="write a Markdown local-first MVP completion report from current audit evidence",
    )
    parser.add_argument(
        "--run-local-verification",
        action="store_true",
        help="run non-opt-in local verification commands and write local-verification.json",
    )
    args = parser.parse_args()
    project_completion_audit(
        Path(args.todo_file),
        Path(args.output_dir),
        Path(args.proof_dir),
        write_next_proof_manifest=args.write_next_proof_manifest,
        write_completion_report_flag=args.write_completion_report,
        run_local_verification_flag=args.run_local_verification,
    )


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"project-audit failed: {exc}", file=sys.stderr)
        sys.exit(1)
