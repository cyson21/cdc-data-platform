#!/usr/bin/env python3
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
DEFAULT_OUTPUT_DIR = ROOT / "lakehouse" / "out" / "project-audit"
DEFAULT_PROOF_DIR = ROOT / "lakehouse" / "out" / "proofs"
CHECKBOX_RE = re.compile(r"^- \[(?P<mark>[ xX])\] (?P<text>.+)$")


def run_command(command, check=True):
    completed = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if check and completed.returncode != 0:
        raise RuntimeError(
            "command failed\n"
            f"command: {' '.join(command)}\n"
            f"stdout:\n{completed.stdout}\n"
            f"stderr:\n{completed.stderr}"
        )
    return completed


def truncate_text(value, limit=4000):
    if len(value) <= limit:
        return value
    return value[:limit] + "\n...<truncated>..."


def git_repository_status():
    git_root = run_command(["git", "rev-parse", "--show-toplevel"]).stdout.strip()
    status = run_command(["git", "status", "--short", "--branch"]).stdout.strip().splitlines()
    return {
        "expectedRoot": str(ROOT),
        "gitRoot": git_root,
        "insideExpectedRoot": git_root == str(ROOT),
        "statusShortBranch": status,
    }


def is_optional_todo_item(section):
    return bool(section and section.lower().startswith("p5. optional"))


def parse_todo(todo_file):
    checked_items = []
    unchecked_items = []
    mvp_unchecked_items = []
    optional_unchecked_items = []
    current_section = None
    lines = todo_file.read_text(encoding="utf-8").splitlines()
    for line_number, line in enumerate(lines, start=1):
        if line.startswith("## "):
            current_section = line.removeprefix("## ").strip()
            continue
        match = CHECKBOX_RE.match(line)
        if not match:
            continue
        item = {
            "section": current_section,
            "line": line_number,
            "text": match.group("text"),
            "optional": is_optional_todo_item(current_section),
        }
        if match.group("mark").lower() == "x":
            checked_items.append(item)
        else:
            unchecked_items.append(item)
            if item["optional"]:
                optional_unchecked_items.append(item)
            else:
                mvp_unchecked_items.append(item)
    return {
        "path": str(todo_file),
        "checkedCount": len(checked_items),
        "uncheckedCount": len(unchecked_items),
        "mvpUncheckedCount": len(mvp_unchecked_items),
        "optionalUncheckedCount": len(optional_unchecked_items),
        "checkedItems": checked_items,
        "uncheckedItems": unchecked_items,
        "mvpUncheckedItems": mvp_unchecked_items,
        "optionalUncheckedItems": optional_unchecked_items,
    }


def lakehouse_proof_audit():
    completed = run_command([
        str(ROOT / "tools" / "runner" / "lakehouse-smoke"),
        "lakehouse-proof-audit",
    ])
    return json.loads(completed.stdout)


def proof_event_ids(proof):
    return proof.get("eventIds") or proof.get("eventId") or []


def proof_event_offset_lsns(proof):
    return [
        offset.get("lsn")
        for offset in proof.get("eventSourceOffset", [])
        if isinstance(offset, dict)
    ]


def read_json_artifact(path):
    return json.loads(path.read_text(encoding="utf-8"))


def phase2_runtime_sla_proof_audit(proof_dir):
    runtime_path = proof_dir / "quality-sla-runtime.json"
    record_path = proof_dir / "quality-sla-runtime-record.json"
    missing = [
        str(path)
        for path in (runtime_path, record_path)
        if not path.exists()
    ]
    base = {
        "scenario": "phase2-runtime-sla-proof-audit",
        "evidenceLabel": "phase2-runtime-sla-proof-audit",
        "proofDir": str(proof_dir),
        "requiredArtifacts": {
            "runtimeObservation": str(runtime_path),
            "controlPlanePersistence": str(record_path),
        },
        "missingArtifacts": missing,
        "nextAction": (
            "Run `cdc-smoke quality-sla-runtime` and "
            "`control-plane-smoke quality-sla-runtime-record` so both proof artifacts are present."
        ),
    }
    if missing:
        return {
            **base,
            "completionReady": False,
            "status": "missing-runtime-sla-proof",
            "runtimeObservation": None,
            "controlPlanePersistence": None,
            "checks": [],
        }

    runtime = read_json_artifact(runtime_path)
    record = read_json_artifact(record_path)
    runtime_event_ids = proof_event_ids(runtime)
    record_event_ids = proof_event_ids(record)
    runtime_offset_lsns = proof_event_offset_lsns(runtime)
    record_offset_lsns = proof_event_offset_lsns(record)
    checks = [
        {
            "id": "runtime-observation-scenario",
            "passed": runtime.get("scenario") == "quality-sla-runtime",
        },
        {
            "id": "runtime-observation-label",
            "passed": runtime.get("evidenceLabel") == "local-docker-debezium-runtime-sla",
        },
        {
            "id": "control-plane-persistence-scenario",
            "passed": record.get("scenario") == "quality-sla-runtime-record",
        },
        {
            "id": "control-plane-persistence-label",
            "passed": record.get("evidenceLabel") == "testcontainers-postgres-runtime-sla",
        },
        {
            "id": "runtime-label-preserved",
            "passed": record.get("runtimeEvidenceLabel") == runtime.get("evidenceLabel"),
        },
        {
            "id": "source-table-matches",
            "passed": runtime.get("sourceTable") == record.get("sourceTable") == "applicants",
        },
        {
            "id": "source-lsn-matches",
            "passed": runtime.get("sourceLsn") == record.get("sourceLsn") and bool(runtime.get("sourceLsn")),
        },
        {
            "id": "event-ids-match",
            "passed": runtime_event_ids == record_event_ids and bool(runtime_event_ids),
        },
        {
            "id": "event-source-offset-lsn-matches",
            "passed": runtime_offset_lsns == record_offset_lsns and bool(runtime_offset_lsns),
        },
        {
            "id": "sla-status-matches",
            "passed": runtime.get("slaStatus") == record.get("slaStatus"),
        },
        {
            "id": "warning-slo-ids-preserved",
            "passed": set(runtime.get("warningSloIds", [])).issubset(set(record.get("warningSloIds", []))),
        },
    ]
    completion_ready = all(item["passed"] for item in checks)
    return {
        **base,
        "completionReady": completion_ready,
        "status": "satisfied-paired-runtime-sla-proof" if completion_ready else "inconsistent-runtime-sla-proof",
        "runtimeObservation": runtime,
        "controlPlanePersistence": record,
        "checks": checks,
    }


def phase2_runtime_lakehouse_replay_audit(proof_dir):
    handoff_path = proof_dir / "control-plane-runtime-handoff.json"
    replay_path = proof_dir / "runtime-lakehouse-replay.json"
    missing = [
        str(path)
        for path in (handoff_path, replay_path)
        if not path.exists()
    ]
    base = {
        "scenario": "phase2-runtime-lakehouse-replay-audit",
        "evidenceLabel": "phase2-runtime-lakehouse-replay-audit",
        "proofDir": str(proof_dir),
        "requiredArtifacts": {
            "controlPlaneRuntimeHandoff": str(handoff_path),
            "runtimeLakehouseReplay": str(replay_path),
        },
        "missingArtifacts": missing,
        "nextAction": (
            "Run `lakehouse-smoke control-plane-runtime-handoff` and "
            "`lakehouse-smoke runtime-lakehouse-replay` so both proof artifacts are present."
        ),
    }
    if missing:
        return {
            **base,
            "completionReady": False,
            "status": "missing-runtime-lakehouse-replay-proof",
            "handoff": None,
            "replay": None,
            "checks": [],
        }

    handoff = read_json_artifact(handoff_path)
    replay = read_json_artifact(replay_path)
    handoff_event_ids = proof_event_ids(handoff)
    replay_event_ids = proof_event_ids(replay)
    handoff_offset_lsns = proof_event_offset_lsns(handoff)
    replay_offset_lsns = proof_event_offset_lsns(replay)
    replay_keys = replay.get("idempotencyKeys", [])
    checks = [
        {
            "id": "handoff-scenario",
            "passed": handoff.get("scenario") == "control-plane-runtime-handoff",
        },
        {
            "id": "handoff-label",
            "passed": handoff.get("evidenceLabel") == "local-control-plane-runtime-lakehouse-handoff",
        },
        {
            "id": "replay-scenario",
            "passed": replay.get("scenario") == "runtime-lakehouse-replay",
        },
        {
            "id": "replay-label",
            "passed": replay.get("evidenceLabel") == "local-runtime-lakehouse-replay",
        },
        {
            "id": "handoff-source-preserved",
            "passed": replay.get("sourceProofScenario") == handoff.get("scenario"),
        },
        {
            "id": "handoff-object-preserved",
            "passed": replay.get("sourceHandoffObjectPath") == handoff.get("localObjectPath"),
        },
        {
            "id": "source-lsn-matches",
            "passed": handoff.get("sourceLsn") == replay.get("sourceLsn") and bool(handoff.get("sourceLsn")),
        },
        {
            "id": "event-ids-match",
            "passed": handoff_event_ids == replay_event_ids and bool(handoff_event_ids),
        },
        {
            "id": "event-source-offset-lsn-matches",
            "passed": handoff_offset_lsns == replay_offset_lsns and bool(handoff_offset_lsns),
        },
        {
            "id": "replay-attempts-duplicate-suppressed",
            "passed": replay.get("replayAttemptCount", 0) >= 2 and replay.get("suppressedDuplicateCount", 0) >= 1,
        },
        {
            "id": "source-metadata-idempotency-key",
            "passed": bool(replay_keys) and all(isinstance(key, str) and key.startswith("sha256:") for key in replay_keys),
        },
    ]
    completion_ready = all(item["passed"] for item in checks)
    return {
        **base,
        "completionReady": completion_ready,
        "status": "satisfied-runtime-lakehouse-replay-proof" if completion_ready else "inconsistent-runtime-lakehouse-replay-proof",
        "handoff": handoff,
        "replay": replay,
        "checks": checks,
    }


def build_next_actions(todo, lakehouse, phase2_runtime_sla, phase2_runtime_replay):
    actions = []
    for item in todo["mvpUncheckedItems"]:
        actions.append({
            "source": "TODO.md",
            "section": item["section"],
            "text": item["text"],
        })
    for item in lakehouse.get("blockingUnmetRequirements", []):
        actions.append({
            "source": "lakehouse-proof-audit",
            "id": item["id"],
            "text": item["nextAction"],
        })
    if not phase2_runtime_sla.get("completionReady"):
        actions.append({
            "source": "phase2-runtime-sla-proof-audit",
            "id": phase2_runtime_sla["status"],
            "text": phase2_runtime_sla["nextAction"],
        })
    if not phase2_runtime_replay.get("completionReady"):
        actions.append({
            "source": "phase2-runtime-lakehouse-replay-audit",
            "id": phase2_runtime_replay["status"],
            "text": phase2_runtime_replay["nextAction"],
        })
    return actions


def build_optional_next_actions(todo, lakehouse):
    actions = []
    for item in todo["optionalUncheckedItems"]:
        actions.append({
            "source": "TODO.md",
            "section": item["section"],
            "text": item["text"],
        })
    for item in lakehouse.get("optionalUnmetRequirements", []):
        actions.append({
            "source": "lakehouse-proof-audit",
            "id": item["id"],
            "text": item["nextAction"],
        })
    return actions


