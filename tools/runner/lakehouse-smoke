        os.environ.get("CDC_LAKEHOUSE_TRINO_IMAGE", DEFAULT_TRINO_IMAGE),
    ]
    require_local_docker_images(docker_path, images, scenario)
    services = trino_compose_services()
    started_before = {service: compose_service_exists(docker_path, service) for service in services}
    stack = {
        "services": services,
        "images": images,
        "startedBefore": started_before,
    }
    try:
        run_command(compose_command(docker_path) + ["up", "-d", "--no-deps", "--pull", "never"] + services)
        stack["health"] = wait_for_trino_health()
        return stack
    except Exception:
        cleanup_trino_iceberg_stack(docker_path, stack)
        raise


def cleanup_trino_iceberg_stack(docker_path, stack):
    cleanup_enabled = os.environ.get("CDC_LAKEHOUSE_TRINO_COMPOSE_KEEP", "false").lower() != "true"
    if not cleanup_enabled:
        return []
    cleanup_services = [
        service
        for service in reversed(stack["services"])
        if not stack["startedBefore"].get(service, False)
    ]
    if cleanup_services:
        run_command(compose_command(docker_path) + ["rm", "-sf"] + cleanup_services)
    return cleanup_services


def trino_statement_endpoint():
    return os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_ENDPOINT", "http://127.0.0.1:8080/v1/statement")


def trino_request_json(url, method="GET", body=None):
    headers = {
        "X-Trino-User": os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_USER", "cdc_local"),
        "X-Trino-Source": "cdc-data-platform-lakehouse-smoke",
    }
    data = None
    if body is not None:
        data = body.encode("utf-8")
        headers["Content-Type"] = "text/plain; charset=utf-8"
    request = Request(url, data=data, headers=headers, method=method)
    with urlopen(request, timeout=float(os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_TIMEOUT_SECONDS", "30"))) as response:
        payload = response.read().decode("utf-8")
        return {
            "status": response.status,
            "payload": json.loads(payload) if payload else {},
        }


def run_trino_sql(_docker_path, sql):
    endpoint = trino_statement_endpoint()
    poll_seconds = float(os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_POLL_SECONDS", "0.25"))
    max_polls = int(os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_MAX_POLLS", "120"))
    retry_seconds = float(os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_RETRY_SECONDS", "1"))
    max_attempts = int(os.environ.get("CDC_LAKEHOUSE_TRINO_QUERY_MAX_ATTEMPTS", "30"))
    responses = []
    for attempt in range(max_attempts):
        responses = [trino_request_json(endpoint, method="POST", body=sql)]
        for _ in range(max_polls):
            payload = responses[-1]["payload"]
            if "error" in payload:
                error = payload["error"]
                if error.get("errorName") == "SERVER_STARTING_UP" and attempt < max_attempts - 1:
                    time.sleep(retry_seconds)
                    break
                raise RuntimeError(
                    "Trino statement failed\n"
                    f"endpoint: {endpoint}\n"
                    f"message: {error.get('message')}\n"
                    f"errorCode: {error.get('errorCode')}\n"
                    f"errorName: {error.get('errorName')}"
                )
            state = payload.get("stats", {}).get("state")
            next_uri = payload.get("nextUri")
            if state in {"FINISHED", "FAILED", "CANCELED"} or not next_uri:
                if state in {"FAILED", "CANCELED"}:
                    raise RuntimeError(f"Trino statement ended with state={state}; endpoint={endpoint}")
                break
            time.sleep(poll_seconds)
            responses.append(trino_request_json(next_uri))
        else:
            raise RuntimeError(f"Trino statement did not finish after {max_polls} polls; endpoint={endpoint}")

        payload = responses[-1]["payload"]
        if payload.get("error", {}).get("errorName") == "SERVER_STARTING_UP":
            continue
        break
    else:
        raise RuntimeError(f"Trino server did not become query-ready after {max_attempts} attempts; endpoint={endpoint}")

    final_payload = responses[-1]["payload"]
    return {
        "command": ["POST", endpoint],
        "stdout": json.dumps(final_payload, sort_keys=True),
        "stderr": "",
        "exitCode": 0,
    }


