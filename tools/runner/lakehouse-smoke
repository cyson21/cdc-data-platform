def required_athena_execution_config():
    if not truthy_env("CDC_LAKEHOUSE_ATHENA_OPT_IN"):
        raise RuntimeError(
            "CDC_LAKEHOUSE_ATHENA_OPT_IN=true is required before running Athena mart execution"
        )
    database = os.environ.get("CDC_LAKEHOUSE_ATHENA_DATABASE")
    output_location = os.environ.get("CDC_LAKEHOUSE_ATHENA_OUTPUT_LOCATION")
    if not database:
        raise RuntimeError("CDC_LAKEHOUSE_ATHENA_DATABASE is required for Athena mart execution")
    if not output_location:
        raise RuntimeError("CDC_LAKEHOUSE_ATHENA_OUTPUT_LOCATION is required for Athena mart execution")
    aws_path = command_path("aws")
    if not aws_path:
        raise RuntimeError("aws CLI is required for Athena mart execution")
    return {
        "awsPath": aws_path,
        "database": database,
        "outputLocation": output_location,
        "workgroup": os.environ.get("CDC_LAKEHOUSE_ATHENA_WORKGROUP", "primary"),
        "catalog": os.environ.get("CDC_LAKEHOUSE_ATHENA_CATALOG", "AwsDataCatalog"),
        "pollSeconds": float(os.environ.get("CDC_LAKEHOUSE_ATHENA_POLL_SECONDS", "2")),
        "maxPolls": int(os.environ.get("CDC_LAKEHOUSE_ATHENA_MAX_POLLS", "30")),
    }


def run_aws_json(command):
    completed = run_command(command, check=False)
    if completed.returncode != 0:
        raise RuntimeError(
            "AWS CLI command failed\n"
            f"command: {' '.join(command)}\n"
            f"stdout:\n{completed.stdout}\n"
            f"stderr:\n{completed.stderr}"
        )
    try:
        return json.loads(completed.stdout or "{}")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"AWS CLI returned non-JSON output: {completed.stdout}") from exc


def start_athena_query(config, sql):
    response = run_aws_json([
        config["awsPath"],
        "athena",
        "start-query-execution",
        "--query-string",
        sql,
        "--work-group",
        config["workgroup"],
        "--query-execution-context",
        f"Database={config['database']},Catalog={config['catalog']}",
        "--result-configuration",
        f"OutputLocation={config['outputLocation']}",
    ])
    query_execution_id = response.get("QueryExecutionId")
    if not query_execution_id:
        raise RuntimeError(f"Athena start-query-execution response missing QueryExecutionId: {response}")
    return query_execution_id


def get_athena_query_execution(config, query_execution_id):
    return run_aws_json([
        config["awsPath"],
        "athena",
        "get-query-execution",
        "--query-execution-id",
        query_execution_id,
    ])


def wait_for_athena_query(config, query_execution_id):
    last_response = None
    for _attempt in range(config["maxPolls"]):
        last_response = get_athena_query_execution(config, query_execution_id)
        query = last_response.get("QueryExecution", {})
        status = query.get("Status", {})
        state = status.get("State")
        if state == "SUCCEEDED":
            return {
                "queryExecutionId": query_execution_id,
                "state": state,
                "outputLocation": query.get("ResultConfiguration", {}).get("OutputLocation"),
            }
        if state in {"FAILED", "CANCELLED"}:
            raise RuntimeError(
                f"Athena query {query_execution_id} ended with state {state}: "
                f"{status.get('StateChangeReason')}"
            )
        if config["pollSeconds"] > 0:
            time.sleep(config["pollSeconds"])
    raise RuntimeError(f"Athena query {query_execution_id} did not finish: {last_response}")


def athena_mart_execution(output_dir):
    config = required_athena_execution_config()
    plan = write_athena_query_plan(output_dir)
    query_executions = []
    for query_path in plan["athenaQueryFiles"]:
        sql = query_path.read_text(encoding="utf-8")
        query_execution_id = start_athena_query(config, sql)
        query_result = wait_for_athena_query(config, query_execution_id)
        query_result["queryFile"] = str(query_path)
        query_executions.append(query_result)

    proof = {
        "scenario": "athena-mart-execution",
        "evidenceLabel": "athena-cli-opt-in",
        "athenaDatabase": config["database"],
        "athenaCatalog": config["catalog"],
