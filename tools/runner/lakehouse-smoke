        }


def signed_bucket_put(endpoint, bucket, access_key, secret_key, region, request_time):
    headers = signed_s3_put_headers(
        endpoint,
        bucket,
        "",
        b"",
        access_key,
        secret_key,
        region,
        request_time,
    )
    url = f"{endpoint}/{bucket}"
    request = Request(url, data=b"", headers=headers, method="PUT")
    try:
        with urlopen(request, timeout=10) as response:
            return {
                "status": response.status,
                "headers": headers,
            }
    except HTTPError as exc:
        if exc.code == 409:
            return {
                "status": exc.code,
                "headers": headers,
            }
        raise


