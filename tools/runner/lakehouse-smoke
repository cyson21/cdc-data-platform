def signed_put(endpoint, bucket, object_key, body, access_key, secret_key, region, request_time):
    headers = signed_s3_put_headers(
        endpoint,
        bucket,
        object_key,
        body,
        access_key,
        secret_key,
        region,
        request_time,
    )
    url = f"{endpoint}/{bucket}/{quote(object_key, safe='/')}"
