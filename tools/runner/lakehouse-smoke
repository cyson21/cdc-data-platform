def lineage_key_basis(event):
    return "|".join([
        str(event["sourceConnector"]),
        str(event["sourceTable"]),
        str(event["sourcePrimaryKey"]),
        str(event["sourceLsn"]),
        str(event["operation"]),
        str(event["eventId"]),
    ])


def lineage_idempotency_key(event):
    basis = lineage_key_basis(event)
    return "sha256:" + hashlib.sha256(basis.encode("utf-8")).hexdigest()


def lineage_source_metadata(event):
    return {
        "sourceTable": event["sourceTable"],
        "sourcePrimaryKey": event["sourcePrimaryKey"],
        "sourceLsn": event["sourceLsn"],
        "eventSourceOffset": event["eventSourceOffset"],
        "eventId": event["eventId"],
        "operation": event["operation"],
    }


def first_record_by(records, field_name, value):
    for record in sorted(records, key=lambda item: item["id"]):
        if record.get(field_name) == value:
            return record
    return None


def build_multi_table_cdc_lineage(output_dir):
    cdc_events = multi_table_lineage_cdc_events()
    table_state = {
        "agent_tasks": {},
        "applicants": {},
        "evaluations": {},
        "job_postings": {},
    }
    seen_keys = set()
    key_basis = {}
    applied_events = []
    suppressed_duplicate_event_ids = []

    for event in cdc_events:
        key = lineage_idempotency_key(event)
        basis = lineage_key_basis(event)
        key_basis[key] = basis
        if key in seen_keys:
            suppressed_duplicate_event_ids.append(event["eventId"])
            continue
        seen_keys.add(key)
        applied_event = {
            **event,
            "lineageIdempotencyKey": key,
            "lineageIdempotencyKeyBasis": basis,
        }
        applied_events.append(applied_event)
        table = event["sourceTable"]
        primary_key = event["sourcePrimaryKey"]
        if event["operation"] == "d":
            table_state[table].pop(primary_key, None)
            continue
        table_state[table][primary_key] = {
            **event["after"],
            "_sourceMetadata": lineage_source_metadata(event),
        }

    lineage_rows = []
    applicants = table_state["applicants"]
    job_postings = table_state["job_postings"]
    evaluations = list(table_state["evaluations"].values())
    agent_tasks = list(table_state["agent_tasks"].values())
    for applicant_id in sorted(applicants):
        applicant = applicants[applicant_id]
        job_posting = job_postings.get(applicant.get("jobPostingId"))
        evaluation = first_record_by(evaluations, "applicantId", applicant_id)
        agent_task = first_record_by(agent_tasks, "applicantId", applicant_id)
        if job_posting and evaluation and agent_task:
            lineage_status = "COMPLETE"
        elif job_posting:
            lineage_status = "APPLICANT_ONLY"
        else:
            lineage_status = "SOURCE_INCOMPLETE"
        lineage_rows.append({
            "eventDate": "2026-06-12",
            "applicantId": applicant_id,
            "jobPostingId": applicant.get("jobPostingId"),
            "jobTitle": job_posting.get("title") if job_posting else None,
            "applicantStage": applicant.get("stage"),
            "evaluationId": evaluation.get("id") if evaluation else None,
            "evaluationScore": evaluation.get("score") if evaluation else None,
            "evaluationResult": evaluation.get("result") if evaluation else None,
            "agentTaskId": agent_task.get("id") if agent_task else None,
            "agentTaskStatus": agent_task.get("status") if agent_task else None,
            "lineageStatus": lineage_status,
            "sourceLineage": {
                "job_postings": job_posting.get("_sourceMetadata") if job_posting else None,
                "applicants": applicant.get("_sourceMetadata"),
                "evaluations": evaluation.get("_sourceMetadata") if evaluation else None,
                "agent_tasks": agent_task.get("_sourceMetadata") if agent_task else None,
            },
        })

    object_root = output_dir / "object-storage" / DEFAULT_BUCKET
    lineage_path = write_jsonl_to_key(lineage_rows, object_root, LINEAGE_OBJECT_KEY)
    applied_cdc_path = write_jsonl_to_key(applied_events, object_root, LINEAGE_APPLIED_CDC_OBJECT_KEY)
    source_lsn = [event["sourceLsn"] for event in applied_events]
    event_ids = [event["eventId"] for event in applied_events]
    source_tables = sorted({event["sourceTable"] for event in cdc_events})
    proof = {
        "scenario": "multi-table-cdc-lineage",
        "evidenceLabel": "local-multi-table-cdc-lineage",
        "bucket": DEFAULT_BUCKET,
        "sourceTables": source_tables,
        "sourceTableCounts": dict(sorted(Counter(event["sourceTable"] for event in applied_events).items())),
        "rawCdcEventCount": len(cdc_events),
        "appliedCdcEventCount": len(applied_events),
        "suppressedDuplicateCount": len(suppressed_duplicate_event_ids),
        "suppressedDuplicateEventIds": suppressed_duplicate_event_ids,
        "lineageRecordCount": len(lineage_rows),
        "lineageCompleteRecordCount": sum(1 for row in lineage_rows if row["lineageStatus"] == "COMPLETE"),
        "sourceLsn": source_lsn,
        "sourceLsnFrom": min(source_lsn),
        "sourceLsnTo": max(source_lsn),
        "eventIds": event_ids,
        "eventSourceOffset": [event["eventSourceOffset"] for event in applied_events],
        "lineageIdempotencyKeys": [event["lineageIdempotencyKey"] for event in applied_events],
        "lineageIdempotencyKeyBasis": key_basis,
        "lineageObjectKey": LINEAGE_OBJECT_KEY,
        "lineageS3CompatibleUri": f"s3://{DEFAULT_BUCKET}/{LINEAGE_OBJECT_KEY}",
        "lineageLocalObjectPath": str(lineage_path),
        "appliedCdcObjectKey": LINEAGE_APPLIED_CDC_OBJECT_KEY,
        "appliedCdcS3CompatibleUri": f"s3://{DEFAULT_BUCKET}/{LINEAGE_APPLIED_CDC_OBJECT_KEY}",
        "appliedCdcLocalObjectPath": str(applied_cdc_path),
        "notes": (
            "Local multi-table CDC lineage proof. Events from job_postings, applicants, evaluations, and agent_tasks "
            "are joined into applicant-centered lineage rows. Duplicate CDC suppression is based on source metadata, "
            "not wall-clock time. This is not live MinIO/S3, Iceberg engine, Athena, or dbt-athena proof."
        ),
    }
    proof = write_proof_artifact(output_dir, proof["scenario"], proof)
    return proof, lineage_rows, applied_events


