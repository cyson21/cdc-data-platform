    minio_status = minio_proof["status"] or ("ready-for-live-run" if s3_ready else "missing-live-proof")
    engine_bootstrap_proof = engine_proof_status(output_dir, "bootstrap")
    engine_append_proof = engine_proof_status(output_dir, "append")
    engine_bootstrap_status = engine_bootstrap_proof["status"] or (
        "ready-for-engine-run" if engine_ready else "missing-engine-proof"
    )
    engine_append_status = engine_append_proof["status"] or (
        "ready-for-engine-run" if engine_ready else "missing-engine-proof"
    )
    athena_dbt_proof = athena_dbt_proof_status(output_dir)
    athena_dbt_status = athena_dbt_proof["status"] or (
        "ready-for-athena-dbt-run" if athena_ready else "missing-athena-dbt-proof"
    )

    requirements = [
        proof_requirement(
            "local-curated-jsonl",
            "satisfied-local-evidence",
            "local-compatible",
            ["iceberg-convergence", "object-storage-sink"],
            "Keep local fixture evidence current when the curated event shape changes.",
        ),
        proof_requirement(
            "local-mart-validation",
            "satisfied-local-evidence",
            "local-compatible",
            ["mart-result-validation", "athena-mart-query-plan"],
            "Keep mart SQL and rendered Athena query plan in sync.",
        ),
        proof_requirement(
            "live-minio-object-sink",
            minio_status,
            "live-s3-compatible-endpoint",
            ["minio-object-sink", "minio-compose-object-sink"],
            (
                "Run minio-object-sink or minio-compose-object-sink against a prepared MinIO/S3-compatible endpoint "
                "and record HTTP PUT success with event id, source LSN, and event source offset."
            ),
            minio_proof["artifact"],
        ),
        proof_requirement(
            "engine-backed-iceberg-bootstrap",
            engine_bootstrap_status,
            "engine-backed-iceberg",
            ["iceberg-engine-bootstrap", "trino-compose-iceberg-bootstrap"],
            "Run an opt-in Spark/Trino/Iceberg engine bootstrap and record engineExitCode=0.",
            engine_bootstrap_proof["artifact"],
        ),
        proof_requirement(
            "engine-backed-iceberg-append",
            engine_append_status,
            "engine-backed-iceberg",
            ["iceberg-engine-append", "trino-compose-iceberg-append"],
            "Run an opt-in Spark/Trino/Iceberg append and record engineExitCode=0 with appendedRecordCount.",
            engine_append_proof["artifact"],
        ),
        proof_requirement(
            "athena-dbt-runtime",
            athena_dbt_status,
            "aws-athena-dbt-athena",
            ["athena-mart-execution", "dbt-athena-run"],
            "Run the opt-in Athena and dbt-athena scenarios against an explicitly configured target.",
            athena_dbt_proof["artifact"],
            "optional-cloud-proof",
        ),
    ]
    satisfied_statuses = {
        "satisfied-local-evidence",
        "satisfied-live-proof",
        "satisfied-engine-proof",
        "satisfied-athena-dbt-proof",
    }
    unmet = [
        item for item in requirements
        if item["status"] not in satisfied_statuses
    ]
    blocking_unmet = [
        item for item in unmet
        if item["requirementScope"] != "optional-cloud-proof"
    ]
    optional_unmet = [
        item for item in unmet
        if item["requirementScope"] == "optional-cloud-proof"
    ]
    optional_cloud_proof_ready = not optional_unmet
    local_mvp_ready = not blocking_unmet
    proof = {
        "scenario": "lakehouse-proof-audit",
        "evidenceLabel": "lakehouse-proof-audit",
        "auditMode": "actual-live-proof-required",
        "completionReady": local_mvp_ready,
        "completionScope": "local-first-mvp",
        "localMvpReady": local_mvp_ready,
        "optionalCloudProofReady": optional_cloud_proof_ready,
        "requirements": requirements,
        "unmetRequirements": unmet,
        "blockingUnmetRequirements": blocking_unmet,
        "optionalUnmetRequirements": optional_unmet,
        "readiness": {
            "s3EndpointReady": s3_ready,
            "icebergEngineReady": engine_ready,
            "athenaDbtCliReady": athena_ready,
            "awsCliPath": command_path("aws"),
            "dbtCliPath": command_path("dbt"),
            "icebergEngineCommand": engine,
        },
        "notes": (
            "CompletionReady covers the local-first MVP gate: local curated evidence, mart validation, "
            "live MinIO/S3-compatible proof, and engine-backed Iceberg bootstrap/append proof. "
            "Athena/dbt-athena remains optional cloud proof and must not be claimed unless an opt-in run artifact is present."
        ),
    }
    print(json.dumps(proof, indent=2, sort_keys=True))


def local_docker_images(docker):
    if not docker["cliAvailable"] or not docker["daemonResponsive"]:
        return []
    completed = subprocess.run(
        [docker["cliPath"], "images", "--format", "{{.Repository}}:{{.Tag}}"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        return []
    return [line.strip() for line in completed.stdout.splitlines() if line.strip()]


def has_image(images, prefixes=(), contains=()):
    return any(
        any(image.startswith(prefix) for prefix in prefixes)
        or any(fragment in image for fragment in contains)
        for image in images
    )


def truthy_env(name):
    return os.environ.get(name, "").strip().lower() in {"1", "true", "yes", "y", "on"}


def engine_command_status():
    raw_command = os.environ.get("CDC_LAKEHOUSE_ICEBERG_ENGINE_CMD", "").strip()
    status = {
        "configured": bool(raw_command),
        "command": raw_command or None,
        "binary": None,
        "available": False,
        "path": None,
    }
    if not raw_command:
        return status
    try:
        binary = shlex.split(raw_command)[0]
    except ValueError:
        return status
    status["binary"] = binary
    if "/" in binary:
        path = Path(binary)
        status["available"] = path.exists()
        status["path"] = str(path) if status["available"] else None
        return status
    path = command_path(binary)
    status["available"] = path is not None
    status["path"] = path
    return status


def lakehouse_runtime_preflight(_output_dir):
    docker = docker_status()
    images = local_docker_images(docker)
    commands = {
        "minio": command_path("minio"),
        "mc": command_path("mc"),
        "sparkSql": command_path("spark-sql"),
        "sparkSubmit": command_path("spark-submit"),
        "trino": command_path("trino"),
        "dbt": command_path("dbt"),
        "aws": command_path("aws"),
    }
    engine = engine_command_status()
    s3_endpoint_configured = bool(os.environ.get("CDC_LAKEHOUSE_S3_ENDPOINT"))
    s3_credentials_configured = bool(
        os.environ.get("CDC_LAKEHOUSE_S3_ACCESS_KEY")
        and os.environ.get("CDC_LAKEHOUSE_S3_SECRET_KEY")
    )
    athena_opt_in = truthy_env("CDC_LAKEHOUSE_ATHENA_OPT_IN")
    dbt_athena_opt_in = truthy_env("CDC_LAKEHOUSE_DBT_ATHENA_OPT_IN")
    local_images = {
        "minioServer": has_image(images, prefixes=("minio/minio:",)),
        "minioClient": has_image(images, prefixes=("minio/mc:",)),
        "trino": has_image(images, prefixes=("trinodb/trino:", "trino:"), contains=("/trino:",)),
        "spark": has_image(images, prefixes=("apache/spark:", "bitnami/spark:", "spark:"), contains=("/spark:",)),
        "iceberg": has_image(images, contains=("iceberg",)),
        "availableMatches": images,
    }
    readiness = {
        "localMinioStartReady": docker["daemonResponsive"] and local_images["minioServer"],
        "minioObjectSinkReady": s3_endpoint_configured and s3_credentials_configured,
        "icebergEngineReady": engine["configured"] and engine["available"],
        "athenaDbtReady": athena_opt_in and dbt_athena_opt_in and bool(commands["aws"]) and bool(commands["dbt"]),
    }
    blockers = []
    if not docker["cliAvailable"]:
        blockers.append("docker-cli-not-found")
    elif not docker["daemonResponsive"]:
        blockers.append("docker-daemon-not-responsive")
    if not local_images["minioServer"]:
        blockers.append("local-minio-image-not-available")
    if not s3_endpoint_configured:
        blockers.append("s3-endpoint-not-configured")
    if s3_endpoint_configured and not s3_credentials_configured:
        blockers.append("s3-credentials-not-configured")
    if not engine["configured"]:
        blockers.append("iceberg-engine-command-not-configured")
    elif not engine["available"]:
        blockers.append("iceberg-engine-command-not-found")
    if not athena_opt_in or not dbt_athena_opt_in:
        blockers.append("aws-athena-dbt-opt-in-not-configured")
    elif not commands["aws"] or not commands["dbt"]:
        blockers.append("aws-or-dbt-command-not-found")

    proof = {
        "scenario": "lakehouse-runtime-preflight",
        "evidenceLabel": "lakehouse-runtime-preflight",
        "docker": docker,
        "localImages": local_images,
        "commands": commands,
        "configuration": {
            "s3EndpointConfigured": s3_endpoint_configured,
            "s3CredentialsConfigured": s3_credentials_configured,
            "s3Bucket": os.environ.get("CDC_LAKEHOUSE_S3_BUCKET", DEFAULT_BUCKET),
            "icebergEngineCommandConfigured": engine["configured"],
            "icebergEngineCommandBinary": engine["binary"],
            "icebergEngineCommandAvailable": engine["available"],
            "athenaOptInConfigured": athena_opt_in,
            "dbtAthenaOptInConfigured": dbt_athena_opt_in,
        },
        "readiness": readiness,
        "blockers": blockers,
        "nextActions": [
            "Provide CDC_LAKEHOUSE_S3_ENDPOINT and credentials before running minio-object-sink.",
            "Provide CDC_LAKEHOUSE_ICEBERG_ENGINE_CMD before running iceberg-engine-bootstrap and iceberg-engine-append.",
            "Use explicit opt-in environment variables before running AWS Athena or dbt-athena proof.",
        ],
        "notes": "Preflight only. This does not write to MinIO/S3, execute Iceberg SQL, or run Athena/dbt-athena.",
    }
    print(json.dumps(proof, indent=2, sort_keys=True))


