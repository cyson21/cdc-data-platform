    endpoint = os.environ.get("CDC_LAKEHOUSE_S3_ENDPOINT", "http://127.0.0.1:9000")
    started_before = compose_service_exists(docker_path, service)
    started_by_runner = not started_before
    cleanup_enabled = os.environ.get("CDC_LAKEHOUSE_MINIO_COMPOSE_KEEP", "false").lower() != "true"
    cleanup_performed = False

    run_command(compose_command(docker_path) + ["up", "-d", "--no-deps", "--pull", "never", service])
    health = wait_for_minio_health(endpoint)

    keys = [
        "CDC_LAKEHOUSE_S3_ENDPOINT",
        "CDC_LAKEHOUSE_S3_ACCESS_KEY",
        "CDC_LAKEHOUSE_S3_SECRET_KEY",
        "CDC_LAKEHOUSE_S3_BUCKET",
        "CDC_LAKEHOUSE_S3_REGION",
    ]
    original_values = {key: os.environ.get(key) for key in keys}
    os.environ["CDC_LAKEHOUSE_S3_ENDPOINT"] = endpoint
    os.environ.setdefault("CDC_LAKEHOUSE_S3_ACCESS_KEY", "minioadmin")
    os.environ.setdefault("CDC_LAKEHOUSE_S3_SECRET_KEY", "minioadmin")
    os.environ.setdefault("CDC_LAKEHOUSE_S3_BUCKET", DEFAULT_BUCKET)
    os.environ.setdefault("CDC_LAKEHOUSE_S3_REGION", "us-east-1")
    try:
        proof = minio_object_sink_proof(output_dir)
    finally:
        restore_environment(original_values)
        if cleanup_enabled and started_by_runner:
            run_command(compose_command(docker_path) + ["rm", "-sf", service])
            cleanup_performed = True

    proof["scenario"] = "minio-compose-object-sink"
    proof["evidenceLabel"] = "local-minio-live-endpoint"
    proof["compose"] = {
        "projectName": local_compose_project(),
        "composeFile": str(local_compose_file()),
