def backfill_merge_key_basis(event):
    return "|".join([
        str(event["sourceConnector"]),
        str(event["sourceTable"]),
        str(event["sourcePrimaryKey"]),
        str(event["sourceLsn"]),
        str(event["operation"]),
        str(event["eventId"]),
    ])


def backfill_merge_key(event):
    basis = backfill_merge_key_basis(event)
    return "sha256:" + hashlib.sha256(basis.encode("utf-8")).hexdigest()


def backfill_cdc_merge(output_dir):
    snapshot_high_watermark_lsn = 26710000
    snapshot_records = backfill_snapshot_records()
    cdc_events = backfill_cdc_events()
    current_state = {
        record["sourcePrimaryKey"]: {
            "sourceTable": record["sourceTable"],
            "sourcePrimaryKey": record["sourcePrimaryKey"],
            "emailHash": record["emailHash"],
            "stage": record["stage"],
            "snapshotHighWatermarkLsn": snapshot_high_watermark_lsn,
            "lastSourceLsn": snapshot_high_watermark_lsn,
            "lastEventId": None,
        }
        for record in snapshot_records
    }
    seen_merge_keys = set()
    merge_key_basis = {}
    applied_events = []
    suppressed_duplicate_event_ids = []
    deleted_primary_keys = []

    for event in cdc_events:
        if event["sourceLsn"] <= snapshot_high_watermark_lsn:
            continue
        key = backfill_merge_key(event)
        basis = backfill_merge_key_basis(event)
        merge_key_basis[key] = basis
        if key in seen_merge_keys:
            suppressed_duplicate_event_ids.append(event["eventId"])
            continue
        seen_merge_keys.add(key)
        applied_event = {
            **event,
            "mergeIdempotencyKey": key,
            "mergeIdempotencyKeyBasis": basis,
        }
        applied_events.append(applied_event)
        primary_key = event["sourcePrimaryKey"]
        if event["operation"] == "d":
            current_state.pop(primary_key, None)
            deleted_primary_keys.append(primary_key)
            continue
        after = event["after"]
        current_state[primary_key] = {
            "sourceTable": event["sourceTable"],
            "sourcePrimaryKey": primary_key,
            "emailHash": after["emailHash"],
            "stage": after["stage"],
            "snapshotHighWatermarkLsn": snapshot_high_watermark_lsn,
            "lastSourceLsn": event["sourceLsn"],
            "lastEventId": event["eventId"],
            "lastEventSourceOffset": event["eventSourceOffset"],
        }

    merged_records = [
        current_state[primary_key]
        for primary_key in sorted(current_state)
    ]
    object_root = output_dir / "object-storage" / DEFAULT_BUCKET
    merged_path = write_jsonl_to_key(merged_records, object_root, BACKFILL_MERGED_OBJECT_KEY)
    applied_cdc_path = write_jsonl_to_key(applied_events, object_root, BACKFILL_APPLIED_CDC_OBJECT_KEY)
    source_lsn = [event["sourceLsn"] for event in applied_events]
    event_ids = [event["eventId"] for event in applied_events]
    proof = {
        "scenario": "backfill-cdc-merge",
        "evidenceLabel": "local-backfill-cdc-merge",
        "bucket": DEFAULT_BUCKET,
        "snapshotHighWatermarkLsn": snapshot_high_watermark_lsn,
        "snapshotRecordCount": len(snapshot_records),
        "cdcEventCount": len(cdc_events),
        "appliedCdcEventCount": len(applied_events),
        "suppressedDuplicateCount": len(suppressed_duplicate_event_ids),
        "suppressedDuplicateEventIds": suppressed_duplicate_event_ids,
        "deletedRecordCount": len(deleted_primary_keys),
        "deletedPrimaryKeys": deleted_primary_keys,
        "mergedRecordCount": len(merged_records),
        "sourceLsn": source_lsn,
        "sourceLsnFrom": min(source_lsn),
        "sourceLsnTo": max(source_lsn),
        "eventIds": event_ids,
        "eventSourceOffset": [event["eventSourceOffset"] for event in applied_events],
        "mergeIdempotencyKeys": [event["mergeIdempotencyKey"] for event in applied_events],
        "mergeIdempotencyKeyBasis": merge_key_basis,
        "mergedObjectKey": BACKFILL_MERGED_OBJECT_KEY,
        "mergedS3CompatibleUri": f"s3://{DEFAULT_BUCKET}/{BACKFILL_MERGED_OBJECT_KEY}",
        "mergedLocalObjectPath": str(merged_path),
        "appliedCdcObjectKey": BACKFILL_APPLIED_CDC_OBJECT_KEY,
        "appliedCdcS3CompatibleUri": f"s3://{DEFAULT_BUCKET}/{BACKFILL_APPLIED_CDC_OBJECT_KEY}",
        "appliedCdcLocalObjectPath": str(applied_cdc_path),
        "notes": (
            "Local Backfill + CDC merge proof. Snapshot rows are merged with CDC events above the snapshot high watermark. "
            "Duplicate CDC suppression is based on source metadata, not wall-clock time. "
            "This is not live MinIO/S3, Iceberg engine, Athena, or dbt-athena proof."
        ),
    }
    proof = write_proof_artifact(output_dir, proof["scenario"], proof)
    print(json.dumps(proof, indent=2, sort_keys=True))


