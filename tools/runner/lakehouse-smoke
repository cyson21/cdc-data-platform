        "startedByRunner": started_by_runner,
        "cleanupPerformed": cleanup_performed,
        "healthUrl": health["url"],
        "healthStatus": health["status"],
    }
    proof["notes"] = (
        "Started local MinIO through Docker Compose with --pull never and wrote a signed object. "
        "This is local MinIO proof only; actual AWS remains opt-in."
    )
    write_proof_artifact(output_dir, proof["scenario"], proof)
    print(json.dumps(proof, indent=2, sort_keys=True))


