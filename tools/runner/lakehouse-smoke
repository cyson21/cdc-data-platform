def event_ids_from_record(record):
    event_ids = record.get("eventIds") or record.get("eventId") or []
    if isinstance(event_ids, str):
        return [event_ids]
    return list(event_ids)


def runtime_replay_key_basis(record):
    event_ids = event_ids_from_record(record)
    return "|".join([
        str(record["sourceProofScenario"]),
        str(record["checkName"]),
        str(record["sourceTable"]),
        str(record["sourcePrimaryKey"]),
        str(record["sourceLsnFrom"]),
        str(record["sourceLsnTo"]),
        ",".join(event_ids),
    ])


def runtime_replay_key(record):
    basis = runtime_replay_key_basis(record)
    return "sha256:" + hashlib.sha256(basis.encode("utf-8")).hexdigest()


def partition_value(value):
    return str(value).replace("/", "_").replace(" ", "_")


