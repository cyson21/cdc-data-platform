def valid_minio_live_proof(proof):
    source_lsn = proof.get("sourceLsn")
    offset = proof.get("eventSourceOffset") if isinstance(proof.get("eventSourceOffset"), dict) else {}
    offset_lsn = offset.get("lsn")
    return (
        proof.get("scenario") in MINIO_LIVE_PROOF_SCENARIOS
        and proof.get("evidenceLabel") in MINIO_LIVE_EVIDENCE_LABELS
        and proof.get("httpStatus") == 200
        and isinstance(proof.get("eventId"), str)
        and proof["eventId"].startswith("cdc_")
        and source_lsn is not None
        and offset_lsn is not None
        and str(offset_lsn) == str(source_lsn)
    )


