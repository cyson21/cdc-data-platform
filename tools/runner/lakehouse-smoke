def materialize_lineage_mart_results(lineage_rows):
    grouped = defaultdict(lambda: {
        "applicantIds": set(),
        "completeLineageApplicants": 0,
        "applicantOnlyCount": 0,
        "passedEvaluations": 0,
        "completedAgentTasks": 0,
    })
    for row in lineage_rows:
        key = (row["eventDate"], row["jobPostingId"], row["jobTitle"])
        group = grouped[key]
        group["applicantIds"].add(row["applicantId"])
        if row["lineageStatus"] == "COMPLETE":
            group["completeLineageApplicants"] += 1
        if row["lineageStatus"] == "APPLICANT_ONLY":
            group["applicantOnlyCount"] += 1
        if row["evaluationResult"] == "PASS":
            group["passedEvaluations"] += 1
        if row["agentTaskStatus"] == "COMPLETED":
            group["completedAgentTasks"] += 1

    mart_rows = []
    for event_date, job_posting_id, job_title in sorted(grouped):
        counts = grouped[(event_date, job_posting_id, job_title)]
        total_applicants = len(counts["applicantIds"])
        completion_rate = 0 if total_applicants == 0 else counts["completeLineageApplicants"] / total_applicants
        mart_rows.append({
            "eventDate": event_date,
            "jobPostingId": job_posting_id,
            "jobTitle": job_title,
            "totalApplicants": total_applicants,
            "completeLineageApplicants": counts["completeLineageApplicants"],
            "applicantOnlyCount": counts["applicantOnlyCount"],
            "passedEvaluations": counts["passedEvaluations"],
            "completedAgentTasks": counts["completedAgentTasks"],
            "lineageCompletionRate": completion_rate,
        })
    return {
        "mart_hiring_pipeline_lineage": mart_rows,
    }


