def wait_for_minio_health(endpoint):
    timeout_seconds = float(os.environ.get("CDC_LAKEHOUSE_MINIO_START_TIMEOUT_SECONDS", "30"))
    health_url = os.environ.get("CDC_LAKEHOUSE_MINIO_HEALTH_URL", endpoint.rstrip("/") + "/minio/health/ready")
    deadline = time.monotonic() + timeout_seconds
    last_error = None
    while time.monotonic() < deadline:
        try:
            request = Request(health_url, method="GET")
            with urlopen(request, timeout=2) as response:
                if 200 <= response.status < 500:
                    return {"url": health_url, "status": response.status}
        except Exception as exc:
            last_error = str(exc)
        time.sleep(0.5)
    raise RuntimeError(f"MinIO health endpoint did not become ready: {health_url}; lastError={last_error}")


