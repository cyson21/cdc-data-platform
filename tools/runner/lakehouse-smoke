def now_ms():
    return int(datetime.now(UTC).timestamp() * 1000)


def build_table_metadata(table_root, table_uuid, snapshots=None, current_snapshot_id=None):
    timestamp_ms = now_ms()
    snapshots = snapshots or []
    metadata = {
        "format-version": 2,
        "table-uuid": table_uuid,
        "location": str(table_root),
        "last-sequence-number": len(snapshots),
        "last-updated-ms": timestamp_ms,
        "last-column-id": 7,
        "current-schema-id": 0,
        "schemas": [ICEBERG_SCHEMA],
        "default-spec-id": 0,
        "partition-specs": [ICEBERG_PARTITION_SPEC],
        "last-partition-id": 1000,
        "default-sort-order-id": 0,
        "sort-orders": [ICEBERG_SORT_ORDER],
        "properties": {
            "table.name": TABLE_NAME,
            "write.format.default": "jsonl-fixture",
            "write.metadata.previous-versions-max": "5",
        },
        "snapshots": snapshots,
        "snapshot-log": [],
        "metadata-log": [],
    }
    if current_snapshot_id is not None:
        metadata["current-snapshot-id"] = current_snapshot_id
        metadata["snapshot-log"] = [
            {
                "timestamp-ms": timestamp_ms,
                "snapshot-id": current_snapshot_id,
            }
        ]
    return metadata


def write_metadata(table_root, metadata, version):
    path = metadata_path(table_root, version)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(metadata, indent=2, sort_keys=True), encoding="utf-8")
    return path


def mart_counts(events):
    funnel_dates = {event["eventDate"] for event in events if event["sourceTable"] == "applicants"}
    task_dates = {event["eventDate"] for event in events if event["sourceTable"] == "agent_tasks"}
    stage_counts = Counter(event["stage"] for event in events if event["sourceTable"] == "applicants")
    task_status_counts = Counter(event["agentTaskStatus"] for event in events if event["sourceTable"] == "agent_tasks")
    return {
        "mart_hiring_funnel_daily": max(1, len(funnel_dates) * max(1, len(stage_counts))),
        "mart_agent_task_reliability": max(1, len(task_dates) * max(1, len(task_status_counts))),
    }


def write_mart_outputs(events, output_dir):
    mart_dir = output_dir / "marts"
    mart_dir.mkdir(parents=True, exist_ok=True)

    funnel = defaultdict(Counter)
    reliability = defaultdict(Counter)
    for event in events:
        if event["sourceTable"] == "applicants":
            funnel[event["eventDate"]][event["stage"]] += 1
        if event["sourceTable"] == "agent_tasks":
            reliability[event["eventDate"]][event["agentTaskStatus"]] += 1

    (mart_dir / "mart_hiring_funnel_daily.json").write_text(
        json.dumps(funnel, indent=2, sort_keys=True),
        encoding="utf-8",
    )
    (mart_dir / "mart_agent_task_reliability.json").write_text(
        json.dumps(reliability, indent=2, sort_keys=True),
        encoding="utf-8",
    )


def validate_mart_sql_refs():
    expectations = {
        "mart_hiring_funnel_daily": [
            "{{ ref('curated_hiring_events') }}",
            "applied_events",
            "screening_events",
            "total_applicant_events",
        ],
        "mart_agent_task_reliability": [
            "{{ ref('curated_hiring_events') }}",
            "completed_task_events",
            "total_task_events",
            "completion_rate",
        ],
        "mart_hiring_pipeline_lineage": [
            "{{ ref('curated_hiring_pipeline_lineage') }}",
            "complete_lineage_applicants",
            "applicant_only_count",
            "lineage_completion_rate",
        ],
    }
    for mart_name, expected_fragments in expectations.items():
        path = MART_SQL_FILES[mart_name]
        sql = path.read_text(encoding="utf-8")
        missing = [fragment for fragment in expected_fragments if fragment not in sql]
        if missing:
            raise RuntimeError(f"{path} is missing expected SQL fragments: {missing}")
    return True


def materialize_mart_results(events):
    funnel_by_date = defaultdict(lambda: {
        "appliedEvents": 0,
        "screeningEvents": 0,
        "totalApplicantEvents": 0,
    })
    reliability_by_date = defaultdict(lambda: {
        "completedTaskEvents": 0,
        "totalTaskEvents": 0,
    })

    for event in events:
        event_date = event["eventDate"]
        if event["sourceTable"] == "applicants":
            row = funnel_by_date[event_date]
            if event["stage"] == "APPLIED":
                row["appliedEvents"] += 1
            if event["stage"] == "SCREENING":
                row["screeningEvents"] += 1
            row["totalApplicantEvents"] += 1
        if event["sourceTable"] == "agent_tasks":
            row = reliability_by_date[event_date]
            if event["agentTaskStatus"] == "COMPLETED":
                row["completedTaskEvents"] += 1
            row["totalTaskEvents"] += 1

    funnel_rows = []
    for event_date in sorted(funnel_by_date):
        row = {"eventDate": event_date}
        row.update(funnel_by_date[event_date])
        funnel_rows.append(row)

    reliability_rows = []
    for event_date in sorted(reliability_by_date):
        counts = reliability_by_date[event_date]
        total = counts["totalTaskEvents"]
        completion_rate = 0 if total == 0 else counts["completedTaskEvents"] / total
        reliability_rows.append({
            "eventDate": event_date,
            "completedTaskEvents": counts["completedTaskEvents"],
            "totalTaskEvents": total,
            "completionRate": completion_rate,
        })

    return {
        "mart_hiring_funnel_daily": funnel_rows,
        "mart_agent_task_reliability": reliability_rows,
    }


