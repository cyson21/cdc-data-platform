def docker_status():
    docker_path = command_path("docker")
    status = {
        "cliAvailable": docker_path is not None,
        "cliPath": docker_path,
        "daemonResponsive": False,
        "serverVersion": None,
        "error": None,
    }
    if not docker_path:
        status["error"] = "docker CLI not found on PATH"
        return status

    completed = subprocess.run(
        [docker_path, "version", "--format", "{{.Server.Version}}"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode == 0:
        status["daemonResponsive"] = True
        status["serverVersion"] = completed.stdout.strip()
        return status

    status["error"] = (completed.stderr or completed.stdout).strip()
    return status


