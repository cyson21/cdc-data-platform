def stability_interval_seconds():
    interval = int(os.environ.get("CDC_SMOKE_STABILITY_INTERVAL_SECONDS", "5"))
    if interval < 1:
        raise ValueError("CDC_SMOKE_STABILITY_INTERVAL_SECONDS must be at least 1")
    return interval


def connector_status_summary(name):
    status = http_json(f"/connectors/{name}/status", expected=(200,))
    return {
        "connectorState": status.get("connector", {}).get("state"),
        "taskStates": [task.get("state") for task in status.get("tasks", [])],
    }


def parse_compose_json(stdout):
    text = stdout.strip()
    if not text:
        return []
    try:
        value = json.loads(text)
        return value if isinstance(value, list) else [value]
    except json.JSONDecodeError:
        items = []
        for line in text.splitlines():
            try:
                items.append(json.loads(line))
            except json.JSONDecodeError:
                continue
        return items


def service_status(service):
    result = compose("ps", "-a", "--format", "json", service, check=False)
    if result.returncode != 0:
        return {
            "service": service,
            "state": "unknown",
            "reason": (result.stderr or result.stdout).strip(),
        }
    items = parse_compose_json(result.stdout)
    if not items:
        return {
            "service": service,
            "state": "unknown",
            "rawStatus": result.stdout.strip(),
        }
    item = items[0]
    status = {
        "service": item.get("Service") or service,
        "name": item.get("Name") or item.get("Names"),
        "state": item.get("State"),
        "status": item.get("Status"),
    }
    if item.get("ExitCode") is not None:
        status["exitCode"] = item.get("ExitCode")
    return {key: value for key, value in status.items() if value is not None}


def container_inspect(container_name):
    if not container_name:
        return {
            "available": False,
            "reason": "container name unavailable",
        }
    try:
        result = run(
            ["docker", "inspect", container_name],
            check=False,
            timeout=diagnostic_inspect_timeout_seconds(),
        )
    except subprocess.TimeoutExpired:
        return {
            "available": False,
            "name": container_name,
            "reason": f"docker inspect timed out after {diagnostic_inspect_timeout_seconds()} seconds",
        }
    if result.returncode != 0:
        return {
            "available": False,
            "name": container_name,
            "reason": (result.stderr or result.stdout).strip(),
        }
    try:
        items = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        return {
            "available": False,
            "name": container_name,
            "reason": f"docker inspect returned invalid JSON: {exc}",
            "raw": result.stdout.strip(),
        }
    if not items:
        return {
            "available": False,
            "name": container_name,
            "reason": "docker inspect returned no container records",
        }
    item = items[0]
    state = item.get("State", {})
    config = item.get("Config", {})
    return {
        "available": True,
        "name": container_name,
        "image": config.get("Image"),
        "restartCount": item.get("RestartCount"),
        "state": {
            "status": state.get("Status"),
            "running": state.get("Running"),
            "exitCode": state.get("ExitCode"),
            "oomKilled": state.get("OOMKilled"),
            "error": state.get("Error"),
            "startedAt": state.get("StartedAt"),
            "finishedAt": state.get("FinishedAt"),
        },
    }


def service_log_tail(service):
    tail_lines = diagnostic_log_tail_lines()
    try:
        result = compose(
            "logs",
            "--no-color",
            "--tail",
            str(tail_lines),
            service,
            check=False,
            timeout=diagnostic_docker_timeout_seconds(),
        )
    except subprocess.TimeoutExpired:
        return {
            "available": False,
            "service": service,
            "reason": f"docker compose logs timed out after {diagnostic_docker_timeout_seconds()} seconds",
        }
    if result.returncode != 0:
        return {
            "available": False,
            "service": service,
            "reason": (result.stderr or result.stdout).strip(),
        }
    lines = result.stdout.splitlines()
    return {
        "available": True,
        "service": service,
        "tailLineCount": len(lines),
        "tail": lines[-tail_lines:],
    }


