def connector_stability_failure_message(message, samples):
    diagnostics = service_failure_diagnostics("kafka-connect")
    return (
        f"{message}; "
        f"samples={json.dumps(samples, sort_keys=True)}; "
        f"diagnostics={json.dumps(diagnostics, sort_keys=True)}"
    )


def observe_connector_stability(name, duration_seconds):
    started = time.monotonic()
    deadline = started + duration_seconds
    samples = []
    while True:
        elapsed = int(time.monotonic() - started)
        try:
            summary = connector_status_summary(name)
        except Exception as exc:
            raise RuntimeError(
                connector_stability_failure_message(
                    f"Kafka Connect stability status probe failed: {exc}",
                    samples,
                )
            ) from exc
        task_states = summary["taskStates"]
        sample = {
            "elapsedSeconds": elapsed,
            "connectorState": summary["connectorState"],
            "taskStates": task_states,
            "running": summary["connectorState"] == "RUNNING" and task_states and all(state == "RUNNING" for state in task_states),
        }
        samples.append(sample)
        if not sample["running"]:
            raise RuntimeError(
                connector_stability_failure_message(
                    "Kafka Connect did not stay running",
                    samples,
                )
            )
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return samples
        time.sleep(min(stability_interval_seconds(), remaining))


