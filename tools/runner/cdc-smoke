    )


def event_dedupe_key(event):
    return (event["operation"], event["sourceLsn"], event["eventId"])


def stop_process(process):
    if process.poll() is not None:
        close_process_pipes(process)
        return
    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)
    close_process_pipes(process)


def close_process_pipes(process):
    for stream in (getattr(process, "stdout", None), getattr(process, "stderr", None)):
        if stream and hasattr(stream, "close"):
            stream.close()


def read_remaining_stderr(process):
    if not process.stderr:
        return ""
    try:
        return process.stderr.read()
    except Exception:
        return ""


def consume_applicant_events_for_operations(applicant_id, required_operations):
    required = set(required_operations)
    deadline = time.monotonic() + 90
    matched = []
    observed_applicant_events = []
    while time.monotonic() < deadline:
        process = subprocess.Popen(
            kafka_consumer_command("cdc.raw.public.applicants"),
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        for line in iter(process.stdout.readline, ""):
            try:
                event = parse_event(line)
            except json.JSONDecodeError:
                continue
            if event and event["sourceTable"] == "applicants":
                observed = {
                    "sourcePrimaryKey": event["sourcePrimaryKey"],
                    "operation": event["operation"],
                    "sourceLsn": event["sourceLsn"],
                    "eventId": event["eventId"],
                }
                if observed not in observed_applicant_events:
                    observed_applicant_events.append(observed)
            if event and event["sourcePrimaryKey"] == applicant_id:
                dedupe_key = event_dedupe_key(event)
                if dedupe_key not in [event_dedupe_key(item) for item in matched]:
                    matched.append(event)
            operations = {event["operation"] for event in matched}
            if required.issubset(operations):
                stop_process(process)
                return matched
        return_code = process.wait(timeout=5)
        if return_code != 0:
            reason = read_remaining_stderr(process).strip()
            close_process_pipes(process)
            raise RuntimeError(
                "Kafka consumer failed while reading cdc.raw.public.applicants "
                f"for applicant {applicant_id}: {reason}"
            )
        close_process_pipes(process)
        operations = {event["operation"] for event in matched}
        if required.issubset(operations):
            return matched
        time.sleep(3)
    raise TimeoutError(
        "did not observe required CDC operations "
        f"{sorted(required)} for applicant {applicant_id}; matched={matched}; "
        f"observedApplicantEvents={observed_applicant_events[-10:]}"
    )


def consume_applicant_events(applicant_id):
    return consume_applicant_events_for_operations(applicant_id, {"c", "u", "d"})


def consume_schema_evolution_events(applicant_id):
    deadline = time.monotonic() + 90
    matched = []
    while time.monotonic() < deadline:
        result = compose(
            "exec",
            "-T",
            "kafka",
            kafka_tool("kafka-console-consumer"),
            "--bootstrap-server",
            "kafka:29092",
            "--topic",
            "cdc.raw.public.applicants",
            "--from-beginning",
            "--max-messages",
            os.environ.get("CDC_SMOKE_CONSUMER_MAX_MESSAGES", "80"),
            "--timeout-ms",
            os.environ.get("CDC_SMOKE_CONSUMER_TIMEOUT_MS", "30000"),
            check=False,
            timeout=120,
        )
        for line in result.stdout.splitlines():
            try:
                event = parse_event(line)
            except json.JSONDecodeError:
                continue
            if event and event["sourcePrimaryKey"] == applicant_id:
                dedupe_key = (event["operation"], event["sourceLsn"], event["eventId"])
                if dedupe_key not in [(item["operation"], item["sourceLsn"], item["eventId"]) for item in matched]:
                    matched.append(event)
        operations = {event["operation"] for event in matched}
        schema_added_update = [
            event for event in matched
            if event["operation"] == "u" and event["after"].get("screening_score") is not None
        ]
        if {"c", "u"}.issubset(operations) and schema_added_update:
            return matched
        time.sleep(3)
    raise TimeoutError(
        "did not observe schema evolution CDC update for applicant "
        f"{applicant_id}; matched={matched}"
    )


def connector_offsets(name):
    try:
        return http_json(f"/connectors/{name}/offsets", expected=(200,))
    except (RuntimeError, TimeoutError, urllib.error.URLError) as exc:
        return {"unavailable": str(exc)}


def prepare_runtime_connector():
    log("checking Docker daemon")
    require_docker_available()
    log("starting source-postgres and kafka")
    compose("up", "-d", "source-postgres", "kafka", timeout=180)
    log("waiting for source-postgres")
    wait_for_postgres()
    log("ensuring ats_source database exists")
    ensure_source_database()
    log("applying source schema")
    apply_source_schema()
    log("waiting for Kafka broker")
    wait_for_kafka()
    log("resetting local CDC topics")
    reset_cdc_topics()
    log("creating Kafka topics")
    create_topics()
    log("resetting local Kafka Connect internal topics")
    reset_connect_internal_topics()
    log("creating local Kafka Connect internal topics")
    create_connect_internal_topics()
    log("starting kafka-connect")
    compose("up", "-d", "--force-recreate", "kafka-connect", timeout=180)
    log("waiting for Kafka Connect")
    wait_for_connect()
    log("registering Debezium connector")
    connector_name = register_connector()
    log("waiting for Debezium connector to run")
    wait_for_connector_running(connector_name)
    log("waiting for Debezium replication slot to become active")
    wait_for_debezium_streaming_slot()
    return connector_name


def applicant_change_capture():
    connector_name = prepare_runtime_connector()
    log("mutating applicant row")
    applicant_id = mutate_applicant()
    log("consuming raw applicant CDC events")
    events = consume_applicant_events(applicant_id)
    offsets = connector_offsets(connector_name)

    event_ids = [event["eventId"] for event in events]
    proof = {
        "scenario": "applicant-change-capture",
        "sourceTable": "applicants",
        "sourcePrimaryKey": applicant_id,
        "connectorTableIncludeList": runtime_connector_table_include_list(),
        "operations": [event["operation"] for event in events],
        "sourceLsn": [event["sourceLsn"] for event in events],
        "eventSourceOffset": [event["sourceOffset"] for event in events],
        "eventId": event_ids,
        "eventIds": event_ids,
        "rawTopic": "cdc.raw.public.applicants",
        "rawEventCount": len(events),
        "canonicalEventCount": 0,
        "canonicalStatus": "not_implemented_in_m2_source_cdc_slice",
        "sourceOffset": offsets,
    }
    print(json.dumps(proof, indent=2, sort_keys=True))


