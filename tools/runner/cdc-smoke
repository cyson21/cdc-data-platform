def source_lsn_sort_value(value):
    if isinstance(value, int):
        return value
    if isinstance(value, str) and value.isdigit():
        return int(value)
    if isinstance(value, list) and value:
        return source_lsn_sort_value(value[-1])
    return None


def duplicate_event_count(events):
    keys = [(event["operation"], event["sourceLsn"], event["eventId"]) for event in events]
    return len(keys) - len(set(json.dumps(key, sort_keys=True) for key in keys))


def missing_event_count(events, expected_operations):
    observed = {event["operation"] for event in events}
    return len(set(expected_operations) - observed)


def durable_offset_resumed(pre_restart_events, post_restart_events):
    pre_lsns = [
        source_lsn_sort_value(event["sourceLsn"])
        for event in pre_restart_events
    ]
    post_lsns = [
        source_lsn_sort_value(event["sourceLsn"])
        for event in post_restart_events
    ]
    pre_lsns = [value for value in pre_lsns if value is not None]
    post_lsns = [value for value in post_lsns if value is not None]
    return bool(pre_lsns and post_lsns and min(post_lsns) > max(pre_lsns))


def current_time_millis():
    return int(time.time() * 1000)


def env_float(name, default):
    value = os.environ.get(name)
    if value is None:
        return default
    parsed = float(value)
    if parsed < 0:
        raise ValueError(f"{name} must be non-negative")
    return parsed


def env_int(name, default):
    value = os.environ.get(name)
    if value is None:
        return default
    parsed = int(value)
    if parsed < 0:
        raise ValueError(f"{name} must be non-negative")
    return parsed


def ratio(numerator, denominator, empty_value):
    if denominator == 0:
        return empty_value
    return numerator / denominator


def unique_runtime_events(events):
    unique = []
    seen = set()
    for event in events:
        key = json.dumps(event_dedupe_key(event), sort_keys=True)
        if key not in seen:
            seen.add(key)
            unique.append(event)
    return unique


def numeric_source_lsn_values(events):
    values = []
    for event in events:
        value = source_lsn_sort_value(event.get("sourceLsn"))
        if value is not None:
            values.append(value)
    return values


def latest_source_timestamp_millis(events):
    values = []
    for event in events:
        value = event.get("sourceTimestampMillis")
        if isinstance(value, int):
            values.append(value)
        elif isinstance(value, str) and value.isdigit():
            values.append(int(value))
    return max(values) if values else None


def extract_connector_offset_lsn(offsets):
    candidates = []

    def visit(value):
        if isinstance(value, dict):
            if "lsn" in value:
                parsed = source_lsn_sort_value(value["lsn"])
                if parsed is not None:
                    candidates.append(parsed)
            for child in value.values():
                visit(child)
        elif isinstance(value, list):
            for child in value:
                visit(child)

    visit(offsets)
    return max(candidates) if candidates else None


def runtime_sla_thresholds():
    return {
        "minCompletenessRatio": env_float("CDC_SMOKE_RUNTIME_SLA_MIN_COMPLETENESS_RATIO", 1.0),
        "maxDuplicateRatio": env_float("CDC_SMOKE_RUNTIME_SLA_MAX_DUPLICATE_RATIO", 0.0),
        "maxFreshnessLagMillis": env_int("CDC_SMOKE_RUNTIME_SLA_MAX_FRESHNESS_LAG_MILLIS", 600000),
        "maxSourceLsnLag": env_int("CDC_SMOKE_RUNTIME_SLA_MAX_SOURCE_LSN_LAG", 1000000),
    }


def build_runtime_sla_proof(
    connector_name,
    applicant_id,
    events,
    offsets,
    *,
    observed_at_millis=None,
):
    observed_at = observed_at_millis if observed_at_millis is not None else current_time_millis()
    thresholds = runtime_sla_thresholds()
    required_operations = set(RUNTIME_SLA_REQUIRED_OPERATIONS)
    unique_events = unique_runtime_events(events)
    duplicate_count = duplicate_event_count(events)
    missing_count = missing_event_count(events, required_operations)
    expected_event_count = len(required_operations)
    observed_required_operations = {
        event["operation"] for event in unique_events
        if event["operation"] in required_operations
    }
    completeness_ratio = ratio(len(observed_required_operations), expected_event_count, 1.0)
    duplicate_ratio = ratio(duplicate_count, len(events), 0.0)
    source_lsn_values = numeric_source_lsn_values(events)
    source_lsn_from = min(source_lsn_values) if source_lsn_values else None
    source_lsn_to = max(source_lsn_values) if source_lsn_values else None
    latest_source_ts = latest_source_timestamp_millis(events)
    freshness_lag = None if latest_source_ts is None else max(0, observed_at - latest_source_ts)
    connector_offset_lsn = extract_connector_offset_lsn(offsets)
    if source_lsn_to is None or connector_offset_lsn is None:
        source_lsn_lag = None
    else:
        source_lsn_lag = max(0, connector_offset_lsn - source_lsn_to)

    violated_slo_ids = []
    warning_slo_ids = []
    if completeness_ratio < thresholds["minCompletenessRatio"] or missing_count > 0:
        violated_slo_ids.append("completeness")
    if duplicate_ratio > thresholds["maxDuplicateRatio"]:
        violated_slo_ids.append("duplicate-rate")
    elif duplicate_count > 0:
        warning_slo_ids.append("duplicate-rate")
    if freshness_lag is None:
        warning_slo_ids.append("freshness-unavailable")
    elif freshness_lag > thresholds["maxFreshnessLagMillis"]:
        violated_slo_ids.append("freshness")
    if source_lsn_lag is None:
        warning_slo_ids.append("source-lsn-lag-unavailable")
    elif source_lsn_lag > thresholds["maxSourceLsnLag"]:
        violated_slo_ids.append("source-lsn-lag")

    if violated_slo_ids:
        sla_status = "FAILED"
    elif warning_slo_ids:
        sla_status = "WARN"
    else:
        sla_status = "PASSED"

    event_ids = [event["eventId"] for event in events]
    proof = {
        "scenario": "quality-sla-runtime",
        "evidenceLabel": "local-docker-debezium-runtime-sla",
        "sourceTable": "applicants",
        "sourcePrimaryKey": applicant_id,
        "connectorName": connector_name,
        "connectorTableIncludeList": runtime_connector_table_include_list(),
        "requiredOperations": list(RUNTIME_SLA_REQUIRED_OPERATIONS),
        "operations": [event["operation"] for event in events],
        "sourceLsn": [event["sourceLsn"] for event in events],
        "sourceLsnFrom": source_lsn_from,
        "sourceLsnTo": source_lsn_to,
        "eventSourceOffset": [event["sourceOffset"] for event in events],
        "eventId": event_ids,
        "eventIds": event_ids,
        "rawTopic": "cdc.raw.public.applicants",
        "rawEventCount": len(events),
        "expectedEventCount": expected_event_count,
        "observedRuntimeEventCount": len(unique_events),
        "duplicateEventCount": duplicate_count,
        "missingEventCount": missing_count,
        "completenessRatio": completeness_ratio,
        "duplicateRatio": duplicate_ratio,
        "freshnessLagMillis": freshness_lag,
        "maxFreshnessLagMillis": thresholds["maxFreshnessLagMillis"],
        "sourceConnectorOffsetLsn": connector_offset_lsn,
        "sourceLsnLag": source_lsn_lag,
        "maxSourceLsnLag": thresholds["maxSourceLsnLag"],
        "minCompletenessRatio": thresholds["minCompletenessRatio"],
        "maxDuplicateRatio": thresholds["maxDuplicateRatio"],
        "slaStatus": sla_status,
        "violatedSloIds": violated_slo_ids,
        "warningSloIds": warning_slo_ids,
        "sourceOffset": offsets,
        "notes": (
            "Local Docker Debezium/Kafka runtime SLA observation. "
            "Freshness is derived from Debezium event ts_ms and local observation time; "
            "event ids remain source metadata based. This is not production-scale proof."
        ),
    }
    return proof


