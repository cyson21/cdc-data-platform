def parse_event(line):
    if not line or line == "null":
        return None
    value = json.loads(line)
    envelope = value.get("payload", value) if isinstance(value, dict) else None
    if not isinstance(envelope, dict):
        return None
    source = envelope.get("source") or {}
    after = envelope.get("after") or {}
    before = envelope.get("before") or {}
    primary_key = str((after or before).get("id", ""))
    operation = envelope.get("op", "")
    source_lsn = source.get("lsn") or source.get("sequence")
    event_id = source_event_id(
        str(source.get("name", "cdc.raw")),
        str(source.get("schema", "public")),
        str(source.get("table", "applicants")),
        primary_key,
        source_lsn,
        operation,
    )
    return {
        "sourceTable": source.get("table"),
        "sourcePrimaryKey": primary_key,
        "operation": operation,
        "sourceLsn": source_lsn,
        "sourceOffset": source_offset(source, source_lsn),
        "sourceTimestampMillis": envelope.get("ts_ms"),
        "eventId": event_id,
        "rawTopic": "cdc.raw.public.applicants",
        "before": before,
        "after": after,
    }


def source_event_id(source_connector, source_schema, source_table, source_primary_key, source_lsn, operation):
    material = "\n".join(
        [
            source_connector,
            source_schema,
            source_table,
            source_primary_key,
            str(source_lsn),
            operation,
        ]
    )
    return "cdc_" + hashlib.sha256(material.encode("utf-8")).hexdigest()[:40]


def source_offset(source, source_lsn):
    offset = {
        "lsn": source_lsn,
        "sequence": source.get("sequence"),
        "txId": source.get("txId"),
    }
    return {key: value for key, value in offset.items() if value is not None}


def consumer_max_messages():
