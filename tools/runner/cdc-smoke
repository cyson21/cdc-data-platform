def docker_health_probe(timeout_seconds=None):
    timeout = timeout_seconds or docker_probe_timeout_seconds()
    command = ["docker", "info", "--format", "{{.ServerVersion}}"]
    try:
        result = run(command, check=False, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {
            "scenario": "docker-preflight",
            "available": False,
            "status": "timeout",
            "command": " ".join(command),
            "reason": f"docker info timed out after {timeout} seconds",
            "composeProjectName": os.environ.get("CDC_SMOKE_COMPOSE_PROJECT_NAME", COMPOSE_PROJECT_NAME),
            "composeFiles": [str(path) for path in compose_files()],
        }
    if result.returncode != 0:
        return {
            "scenario": "docker-preflight",
            "available": False,
            "status": "error",
            "command": " ".join(command),
            "reason": (result.stderr or result.stdout).strip(),
            "composeProjectName": os.environ.get("CDC_SMOKE_COMPOSE_PROJECT_NAME", COMPOSE_PROJECT_NAME),
            "composeFiles": [str(path) for path in compose_files()],
        }
    return {
        "scenario": "docker-preflight",
        "available": True,
        "status": "ok",
        "command": " ".join(command),
        "serverVersion": result.stdout.strip(),
        "composeProjectName": os.environ.get("CDC_SMOKE_COMPOSE_PROJECT_NAME", COMPOSE_PROJECT_NAME),
        "composeFiles": [str(path) for path in compose_files()],
    }


def require_docker_available():
    health = docker_health_probe()
    if not health["available"]:
        raise RuntimeError("Docker preflight failed: " + json.dumps(health, sort_keys=True))
    return health


def docker_preflight():
    print(json.dumps(docker_health_probe(), indent=2, sort_keys=True))


def wait_until(label, probe, timeout_seconds=120, interval_seconds=2):
    deadline = time.monotonic() + timeout_seconds
    last_error = None
    while time.monotonic() < deadline:
        try:
            if probe():
                return
        except Exception as exc:
            last_error = exc
        time.sleep(interval_seconds)
    raise TimeoutError(f"timed out waiting for {label}: {last_error}")


def http_json(path, *, method="GET", payload=None, expected=(200,)):
    body = None if payload is None else json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        f"{CONNECT_URL}{path}",
        data=body,
        method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            response_body = response.read().decode("utf-8")
            if response.status not in expected:
                raise RuntimeError(f"unexpected HTTP {response.status}: {response_body}")
            return json.loads(response_body) if response_body else {}
    except urllib.error.HTTPError as exc:
        response_body = exc.read().decode("utf-8")
        if exc.code not in expected:
            raise RuntimeError(f"unexpected HTTP {exc.code}: {response_body}") from exc
        return json.loads(response_body) if response_body else {}


def wait_for_postgres():
    def probe():
        result = compose(
            "exec",
            "-T",
            "source-postgres",
            "pg_isready",
            "-U",
            "source_user",
            check=False,
        )
        return result.returncode == 0

    wait_until("source-postgres", probe)


def ensure_source_database():
    compose(
        "exec",
        "-T",
        "source-postgres",
        "sh",
        "-c",
        "psql -U source_user -d postgres -tAc \"select 1 from pg_database where datname='ats_source'\" | grep -q 1 || createdb -U source_user ats_source",
    )


def wait_for_connect():
    wait_until("kafka-connect", lambda: bool(http_json("/", expected=(200,))))


def wait_for_kafka():
