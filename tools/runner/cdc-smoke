def register_connector():
    connector_payload = runtime_connector_payload()
    name = connector_payload["name"]
    try:
        http_json("/connectors", method="POST", payload=connector_payload, expected=(201,))
    except RuntimeError as exc:
        if "HTTP 409" not in str(exc):
            raise
        http_json(f"/connectors/{name}/config", method="PUT", payload=connector_payload["config"], expected=(200, 201))
    return name


def wait_for_connector_running(name):
    def probe():
        status = http_json(f"/connectors/{name}/status", expected=(200,))
        connector_state = status.get("connector", {}).get("state")
        task_states = [task.get("state") for task in status.get("tasks", [])]
        return connector_state == "RUNNING" and task_states and all(state == "RUNNING" for state in task_states)

    wait_until(f"connector {name}", probe, timeout_seconds=180)


