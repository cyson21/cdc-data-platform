def psql(sql):
    compose(
        "exec",
        "-T",
        "source-postgres",
        "psql",
        "-U",
        "source_user",
        "-d",
        "ats_source",
        "-v",
        "ON_ERROR_STOP=1",
        "-c",
        sql,
    )


def psql_scalar(sql):
    result = compose(
        "exec",
        "-T",
        "source-postgres",
        "psql",
        "-U",
        "source_user",
        "-d",
        "ats_source",
        "-v",
        "ON_ERROR_STOP=1",
        "-At",
        "-c",
        sql,
        check=False,
        timeout=30,
    )
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip())
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    return lines[-1] if lines else ""


