def log(message):
    print(f"[cdc-smoke] {message}", file=sys.stderr, flush=True)


def run(command, *, input_text=None, check=True, timeout=None):
    completed = subprocess.run(
        command,
        cwd=ROOT,
        input=input_text,
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
    )
    if check and completed.returncode != 0:
        raise RuntimeError(
            f"command failed ({completed.returncode}): {' '.join(command)}\n"
            f"stdout:\n{completed.stdout}\n"
            f"stderr:\n{completed.stderr}"
        )
    return completed


def compose_files():
    files = [COMPOSE_FILE]
    for item in os.environ.get("CDC_SMOKE_EXTRA_COMPOSE_FILES", "").split(os.pathsep):
        if item:
            files.append(Path(item).resolve())
    return files


def compose_command(*args):
    project_name = os.environ.get("CDC_SMOKE_COMPOSE_PROJECT_NAME", COMPOSE_PROJECT_NAME)
    command = ["docker", "compose", "--project-name", project_name]
    for file in compose_files():
        command.extend(["-f", str(file)])
    command.extend(args)
    return command


def compose(*args, input_text=None, check=True, timeout=None):
    return run(
        compose_command(*args),
        input_text=input_text,
        check=check,
        timeout=timeout,
    )


def kafka_tool(tool_name):
    bin_dir = os.environ.get("CDC_SMOKE_KAFKA_BIN_DIR")
    if bin_dir:
        return str(Path(bin_dir) / f"{tool_name}.sh")
    return tool_name


