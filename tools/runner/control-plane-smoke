def source_event_id(source_connector, source_schema, source_table, source_primary_key, source_lsn, operation):
    material = "\n".join([
        source_connector,
        source_schema,
        source_table,
        source_primary_key,
        str(source_lsn),
        operation,
    ])
    return "cdc_" + hashlib.sha256(material.encode("utf-8")).hexdigest()[:40]


def write_proof_artifact(proof_dir, file_name, proof):
    proof_dir.mkdir(parents=True, exist_ok=True)
    artifact_path = proof_dir / file_name
    artifact_path.write_text(json.dumps(proof, indent=2, sort_keys=True), encoding="utf-8")
    return artifact_path


def proof_event_ids(proof):
    return proof.get("eventIds") or proof.get("eventId") or []


