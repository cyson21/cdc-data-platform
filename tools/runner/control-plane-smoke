def run_maven_test(test_selector):
    env = os.environ.copy()
    env.setdefault("TESTCONTAINERS_DOCKERCONFIG_SOURCE", "autoIgnoringUserProperties")
    env.setdefault("TESTCONTAINERS_RYUK_DISABLED", "true")
    env.setdefault("api.version", "1.44")
    if COLIMA_DOCKER_SOCKET.exists():
        env.setdefault("DOCKER_HOST", f"unix://{COLIMA_DOCKER_SOCKET}")

    command = [
        "mvn",
        "-f",
        "backend/pom.xml",
        f"-Dtest={test_selector}",
        "test",
    ]
    completed = subprocess.run(
        command,
        cwd=ROOT,
        text=True,
        capture_output=True,
        env=env,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(
            f"{test_selector} verification failed\n"
            f"stdout:\n{completed.stdout}\n"
            f"stderr:\n{completed.stderr}"
        )
    return command


