def main():
    parser = argparse.ArgumentParser(description="Run local CDC control-plane smoke scenarios.")
    parser.add_argument(
        "--proof-dir",
        default=str(DEFAULT_PROOF_DIR),
        help="directory for machine-readable proof artifacts",
    )
    parser.add_argument(
        "scenario",
        nargs="?",
        choices=[
            "canonical-ingest",
            "sink-failure-replay",
            "kafka-outage-recovery",
            "connector-restart-recovery",
            "kafka-backed-sink-failure-replay",
            "pipeline-quality",
            "pipeline-quality-db",
            "quality-sla",
            "quality-sla-db",
            "quality-sla-runtime-record",
        ],
    )
    args = parser.parse_args()
    if args.scenario == "canonical-ingest":
        run_canonical_ingest()
        return
    if args.scenario == "sink-failure-replay":
        run_sink_failure_replay()
        return
    if args.scenario in {"kafka-outage-recovery", "connector-restart-recovery"}:
        run_recovery_scenario(args.scenario)
        return
    if args.scenario == "kafka-backed-sink-failure-replay":
        run_kafka_backed_sink_failure_replay()
        return
    if args.scenario == "pipeline-quality":
        run_pipeline_quality()
        return
    if args.scenario == "pipeline-quality-db":
        run_pipeline_quality_db()
        return
    if args.scenario == "quality-sla":
        run_quality_sla()
        return
    if args.scenario == "quality-sla-db":
        run_quality_sla_db()
        return
    if args.scenario == "quality-sla-runtime-record":
        run_quality_sla_runtime_record(Path(args.proof_dir))
        return
    parser.print_help()


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"control-plane-smoke failed: {exc}", file=sys.stderr)
        sys.exit(1)
